{
  "productName": "Hydraulic",
  "version": "2.0.0",
  "identifier": "com.hydraulic",

  "build": {
    "frontendDist": "./src",
    "devUrl": null,
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },

  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["resources/ffmpeg/*"],
    "fileAssociations": [
      {
        "ext": ["mp4", "mkv", "mov"],
        "mimeType": "video/*",
        "name": "Hydraulic",
        "description": "Open video files with Hydraulic"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      },
      "wix": {
        "fragmentPaths": ["windows/context-menu.wxs"],
        "componentRefs": ["ContextMenuRegistryEntries"]
      }
    }
  },

  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hydraulic",
        "width": 900,
        "height": 720,
        "minWidth": 600,
        "minHeight": 550,
        "resizable": true,
        "decorations": false,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": { "allow": ["**"], "deny": [] }
      }
    }
  }
}
